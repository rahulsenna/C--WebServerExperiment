{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "BuildServer",
            "command": "/opt/gcc-15/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                // "-g",
                "-O3",
                "--std=c++23",
                "-I${workspaceFolder}/third_party/boost_unordered/include",
                "src/*.cpp",
                "-o",
                "${workspaceFolder}/bin/server",
                "-luring", "-lpthread", "-lsqlite3"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
						"presentation": {
							"echo": true,
							"reveal": "silent",
							"focus": false,
							"panel": "shared",
							"showReuseMessage": true,
							"clear": true
						},
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}