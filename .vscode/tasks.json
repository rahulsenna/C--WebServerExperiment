{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "BuildServer",
            "command": "/opt/gcc-15/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "--std=c++23",
                "*.cpp",
                "-o",
                "${workspaceFolder}/bin/server"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
						"presentation": {
							"echo": true,
							"reveal": "silent",
							"focus": false,
							"panel": "shared",
							"showReuseMessage": true,
							"clear": true
						},
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}